# Copy this file to .env and fill in your key. Never commit .env.

# Required for real AI responses (any OpenAI-compatible provider)
LLM_API_KEY=sk-your-key-here
# Also accepted: OPENAI_API_KEY=sk-your-key-here

# Optional
LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1

# Optional: force sample/demo output even if a key is set
# MOCK_LLM=true

# Optional: Flask debug reloader (development only)
# FLASK_DEBUG=1
# PORT=5000
